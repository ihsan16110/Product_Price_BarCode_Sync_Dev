# Central DB connection
SOURCE_SERVER=localhost
SOURCE_DATABASE=target_db
SOURCE_USER=sa
SOURCE_PASSWORD=your_password

# Direct Head Office acknowledgement connection
HO_SERVER=192.168.11.200
HO_DATABASE=EPSMirror
HO_DB_USERNAME=sa
HO_DB_PASSWORD=your_ho_password

# Dedicated database used for ProductSyncLog and ProductPriceChangeLog.
# This may be a different server/database from the synchronization source.
LOG_SERVER=localhost
LOG_DATABASE=product_sync_log
LOG_USER=product_sync_user
LOG_PASSWORD=replace_with_log_database_password

# Central DB name used inside linked server queries from outlets
CENTRAL_DB=target_db

# Linked server name as it will be created on each outlet
CENTRAL_LINKED_SERVER_NAME=localhost

# Local/outlet database name
LOCAL_DB=local_db

# Outlet DB credentials
OUTLET_DB_USER=sa
OUTLET_DB_PASSWORD=your_password

# Concurrency - max outlets syncing simultaneously
MAX_CONCURRENT_SYNCS=20
# Explicit capacity for outlet ODBC, audit logging, retries, and draining calls
THREAD_POOL_MAX_WORKERS=40

# Connection and query timeouts (seconds)
CONNECT_TIMEOUT=10
QUERY_TIMEOUT=120

# Hard watchdogs (seconds) so one outlet/cycle cannot block future schedules
OUTLET_SYNC_TIMEOUT=180
# Last-resort cycle watchdog; initially allows the measured two-hour baseline plus headroom
FULL_SYNC_TIMEOUT=10800

# Temporary comma-separated exclusion list; remove F786 after DB/network repair
EXCLUDED_OUTLETS=F786

# Sync schedule interval (minutes)
SYNC_INTERVAL_MINUTES=30

# Retry settings for failed outlets
RETRY_MAX_ATTEMPTS=10
RETRY_BASE_DELAY=30

# API server
API_HOST=0.0.0.0
API_PORT=8000
# Host port published by Docker Compose; container port remains 8000.
HOST_PORT=8000

# Required for administrative API operations. Use long random values in production.
ADMIN_API_KEY=replace_with_long_random_admin_key
# Optional separate read-only key for log/history access; admin key also works.
VIEWER_API_KEY=replace_with_long_random_viewer_key
ADMIN_RATE_LIMIT_PER_MINUTE=30

# ProductPriceChangeLog retention
PRICE_CHANGE_RETENTION_DAYS=90
# Audit rows sent per fast executemany batch
PRICE_CHANGE_INSERT_BATCH_SIZE=500
# Disabled operational audit tables. Keep these flags for future reactivation.
ENABLE_PRODUCT_PRICE_CHANGE_LOG=false
ENABLE_PRODUCT_SYNC_LOG_HISTORY=false

# Log directory
LOG_DIR=logs

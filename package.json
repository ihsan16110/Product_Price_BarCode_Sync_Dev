{
  "name": "product-price-sync-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Unit tests for the ProductPriceSync dashboard JavaScript modules",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@babel/preset-env": "7.29.7",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/js/**/*.test.js"
    ],
    "moduleDirectories": [
      "app/static/js",
      "node_modules"
    ],
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "clearMocks": true,
    "resetMocks": false
  }
}
